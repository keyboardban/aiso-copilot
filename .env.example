# AISO Copilot environment configuration
# Copy to .env — the app works with NO .env file at all (free deterministic mode).

# LLM mode: no_llm | openrouter | ollama
# Default MUST stay no_llm. The whole audit pipeline works without any LLM.
LLM_MODE=no_llm

# --- Optional: OpenRouter free mode -----------------------------------------
# Only used when LLM_MODE=openrouter (or selected in the UI).
# You must provide BOTH a key and a model slug; pick a free model yourself
# (e.g. a slug ending in ":free" on openrouter.ai/models). No model is
# hardcoded and nothing is ever called by default.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Optional: local Ollama mode ---------------------------------------------
# Only used when LLM_MODE=ollama and an Ollama server is reachable.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Optional: local embeddings (requirements-local.txt) ---------------------
# Set to 1 only if sentence-transformers is installed. Default off = deterministic.
AISO_USE_EMBEDDINGS=0
# Embedding model. For cross-lingual audits (e.g. a Thai page vs English
# questions) use a multilingual model — it bridges languages far better than the
# English-centric default:
#   AISO_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
AISO_EMBEDDING_MODEL=
