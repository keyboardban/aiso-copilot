# AISO Copilot environment configuration
# Copy to .env — the app works with NO .env file at all (free deterministic mode).

# LLM mode: no_llm | openrouter | ollama
# Default is openrouter (multi-agent free question generation). It is still safe
# with no key: get_provider() falls back to no_llm automatically, so the whole
# audit pipeline always works without any LLM.
LLM_MODE=openrouter

# --- OpenRouter free multi-agent mode ---------------------------------------
# 1) Paste your key (free: https://openrouter.ai/keys). THIS is the place.
OPENROUTER_API_KEY=
# 2) Free model slugs for the multi-agent panel — one per line OR comma-separated.
#    Each model generates questions independently; results are merged & deduped.
#    All must be free-tier (slugs ending in ":free"). Leave blank to use the
#    built-in free defaults. Browse current free models at openrouter.ai/models
#    (filter: Free). Stale/unavailable slugs are skipped automatically.
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free, qwen/qwen3-next-80b-a3b-instruct:free, google/gemma-4-31b-it:free
# Single-model override (optional; OPENROUTER_MODELS takes precedence).
OPENROUTER_MODEL=

# --- Optional: local Ollama mode ---------------------------------------------
# Only used when LLM_MODE=ollama and an Ollama server is reachable.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Local embeddings (requirements-local.txt) ------------------------------
# ON by default. Requires sentence-transformers (pip install -r requirements-local.txt).
# When installed, a multilingual model is used automatically for semantic +
# cross-lingual matching; it downloads once (~470 MB) then runs offline. If the
# package isn't installed or the model can't load, the app falls back to the
# deterministic lexical path. Set to 0 to force deterministic mode.
AISO_USE_EMBEDDINGS=1
# Embedding model (default is the multilingual one below). Override e.g. with the
# smaller English-only model: sentence-transformers/all-MiniLM-L6-v2
AISO_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
